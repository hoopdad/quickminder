<Window x:Class="Quickminder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quickminder" Width="430" Height="600" MinWidth="360" MinHeight="400"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" Topmost="True"
        Background="#FAFBF8" Foreground="{StaticResource Ink}" FontFamily="Segoe UI"
        UseLayoutRounding="True" KeyDown="Window_KeyDown" Closing="Window_Closing">
  <Border BorderBrush="#CBD9D2" BorderThickness="1" Padding="22,18,22,10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,20" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="quickminder" FontSize="25" FontWeight="SemiBold" />
          <TextBlock Text="A little space for what you need." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Folder" Click="Folder_Click" Margin="6,0" VerticalAlignment="Top" ToolTip="Open your plain-text notes folder"/>
        <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" Click="Hide_Click" VerticalAlignment="Top" ToolTip="Hide to tray (Esc)" AutomationProperties.Name="Hide to tray"/>
      </Grid>
      <Grid Grid.Row="1" Margin="0,0,0,14">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="SectionTitle" Text="YOUR NOTES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="BackButton" Content="Back" Visibility="Collapsed" Click="Back_Click" Margin="0,0,6,0"/>
          <Button Content="+ New note" Background="{StaticResource Accent}" Foreground="White" Click="New_Click" ToolTip="New note (Ctrl+N)"/>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="2" Margin="0,0,0,12">
        <TextBlock x:Name="Status" Text="Plain text. Always close." TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
        <Button x:Name="ReloadButton" Content="Reload from disk" Visibility="Collapsed" Click="Reload_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        <TextBlock x:Name="FolderLabel" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"/>
      </StackPanel>
      <Grid Grid.Row="3" x:Name="StackView">
        <ListBox x:Name="NotesList" SelectionChanged="Note_Selected" BorderThickness="0" Padding="0"
                 VerticalAlignment="Bottom"
                 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Your notes">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="Background" Value="#EEF3ED"/>
              <Setter Property="Padding" Value="15"/>
              <Setter Property="Margin" Value="0,10,0,0"/>
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
              <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#DEEAE0"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#D1E6D8"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#D1E6D8"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Preview}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,6,0,12"/>
                <TextBlock Text="{Binding UpdatedLabel}" Foreground="{StaticResource Muted}" FontSize="11"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="Keep it close." FontSize="25" HorizontalAlignment="Center"/>
          <TextBlock Text="Add a note. Copy a line. Get on with your day." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="3" x:Name="EditorView" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button Content="Copy all" Click="CopyAll_Click" HorizontalAlignment="Left"/>
          <Button x:Name="SaveCopyButton" Grid.Column="1" Content="Save a copy" Click="SaveCopy_Click" Margin="6,0"/>
          <Button Grid.Column="2" Content="Delete" Foreground="#A33F38" Background="#F8EBE7" Click="Delete_Click"/>
        </Grid>
        <Border Grid.Row="1" Background="White" BorderBrush="#D9E3DA" BorderThickness="1" CornerRadius="8">
          <Grid Margin="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Canvas x:Name="CopyGutter" ClipToBounds="True"/>
            <TextBox x:Name="Editor" Grid.Column="1" AcceptsReturn="True" AcceptsTab="True"
                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0" Padding="3,4" Background="Transparent" Foreground="{StaticResource Ink}"
                     VerticalContentAlignment="Bottom"
                     FontFamily="Consolas" FontSize="14" TextChanged="Editor_TextChanged"
                     SelectionChanged="Editor_SelectionChanged"
                     ScrollViewer.ScrollChanged="Editor_ScrollChanged" SizeChanged="Editor_SizeChanged"
                     AutomationProperties.Name="Note text" SpellCheck.IsEnabled="False"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
